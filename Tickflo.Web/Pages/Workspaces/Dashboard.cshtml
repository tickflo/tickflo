@page "/workspaces/{slug}/dashboard"
@model Tickflo.Web.Pages.Workspaces.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="flex flex-row gap-2 md:gap-4">
    @await Html.PartialAsync("_WorkspaceSidebar", Model.WorkspaceSlug)
    <section class="relative overflow-hidden p-3 md:p-6 flex-1 min-w-0 space-y-6 md:space-y-8 text-slate-100 rounded-3xl bg-gradient-to-br from-[#0c1220] via-[#0b101b] to-[#0a0f18]">
        @await Html.PartialAsync("_WorkspaceHeader", new Tickflo.Web.Pages.Shared.WorkspaceHeaderView { Slug = Model.WorkspaceSlug, Name = Model.Workspace?.Name ?? "Workspace", SectionTitle = "Dashboard", NewActionLabel = "New Widget", NewActionHref = $"/workspaces/{Model.WorkspaceSlug}/dashboard/0/edit", AllowNewAction = true })

        @if (TempData["Success"] is string success && !string.IsNullOrWhiteSpace(success))
        {
            <div class="alert alert-success rounded-2xl border border-white/10">@success</div>
        }

        @if (Model.Widgets.Count == 0)
        {
            <div class="card bg-neutral-900/85 backdrop-blur shadow-2xl rounded-3xl text-slate-100">
                <div class="card-body text-center py-12">
                    <h2 class="card-title justify-center">No widgets yet</h2>
                    <p class="text-sm text-base-content/70 max-w-md mx-auto">
                        Add a widget to surface live status from Wazuh, Uptime Kuma, or any JSON HTTP endpoint.
                    </p>
                </div>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
                @foreach (var widget in Model.Widgets)
                {
                    <div class="card bg-neutral-900/85 backdrop-blur shadow-xl rounded-3xl border @widget.BorderClass">
                        <div class="card-body">
                            <div class="flex items-start justify-between gap-2">
                                <h3 class="card-title text-base">@widget.Name</h3>
                                <span class="badge @widget.BadgeClass">@widget.Health</span>
                            </div>
                            <div class="text-4xl font-bold mt-2">@(widget.Value ?? "—")</div>
                            <div class="text-xs text-base-content/60 mt-2">
                                @(widget.FetchedAt is DateTime fetched ? $"updated {fetched.ToLocalTime():g}" : "waiting for first poll…")
                            </div>
                            @if (!string.IsNullOrWhiteSpace(widget.ErrorMessage))
                            {
                                <div class="text-xs text-error mt-1">@widget.ErrorMessage</div>
                            }
                            <div class="card-actions justify-end mt-3">
                                <a class="btn btn-sm btn-ghost" asp-page="./DashboardEdit" asp-route-slug="@Model.WorkspaceSlug" asp-route-id="@widget.Id">Edit</a>
                                <form method="post" asp-page-handler="Delete" asp-route-slug="@Model.WorkspaceSlug" asp-route-id="@widget.Id" onsubmit="return confirm('Delete this widget?');">
                                    <button type="submit" class="btn btn-sm btn-ghost text-error">Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
</div>

@section Scripts {
    <script>
        setInterval(function () {
            if (document.visibilityState === 'visible') { location.reload(); }
        }, 60000);
    </script>
}
