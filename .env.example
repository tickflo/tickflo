DATABASE_URL=postgres://tickflo:password@localhost:5432/tickflo?sslmode=disable

# Tickflo (TickfloConfig)
PostgresUser=tickflo
PostgresPassword=password
PostresDatabase=tickflo
PostgresHost=localhost
BaseUrl=http://localhost:3000
MailgunApiKey=your-mailgun-api-key-here
AppEnv=Development
# Data Protection key ring (encrypts widget secrets at rest). Mount a persistent
# Docker volume at this path so secrets survive container restarts.
# DataProtectionKeyPath=/app/data-protection-keys

# Self-hosted: allow widgets to target private/LAN hosts (e.g. Wazuh on the LAN).
# Leave unset (false) for multi-tenant SaaS to keep widget URLs SSRF-guarded.
# AllowPrivateWidgetTargets=true

# RustFS/S3 Storage Configuration
S3EndPoint=http://localhost:9000
S3AccessKey=tickflo
S3SecretKey=password
S3Bucket=tickflo
S3Region=us-east-1
